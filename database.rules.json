{
  "rules": {
    ".read": false,
    ".write": false,
    "controllerRooms": {
      ".read": false,
      ".write": false
    },
    "rooms": {
      ".indexOn": ["controllerPresence/lastSeen", "status"],
      "$roomCode": {
        ".write": false,
        "roomCode": {".read": "auth != null"},
        "controllerUid": {
          ".read": "auth != null && (data.val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())"
        },
        "controllerSessionId": {".read": false, ".write": false},
        "createdAt": {".read": "auth != null"},
        "status": {
          ".read": "auth != null && (root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())",
          ".write": false
        },
        "controllerConnected": {".read": "auth != null", ".write": false},
        "controllerPresence": {
          ".read": "auth != null && (root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())",
          ".write": "auth != null && root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid",
          ".validate": "newData.hasChildren(['connected', 'lastSeen']) && newData.child('connected').isBoolean() && newData.child('lastSeen').isNumber() && newData.child('lastSeen').val() <= now + 10000"
        },
        "maxPlayers": {".read": "auth != null"},
        "selectedGame": {".read": "auth != null", ".write": false},
        "players": {
          ".read": "auth != null",
          "$playerUid": {
            ".write": false,
            "nickname": {
              ".write": false,
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12"
            },
            "characterId": {
              ".write": false,
              ".validate": "newData.isString() && newData.val().matches(/^(bear|bee|cat|crab|deer|elephant|frog|giraffe|hedgehog|kindbear|octopus|owl|penguin|rabbit|shark|snake|whale)$/)"
            },
            "isConnected": {
              ".write": "auth != null && auth.uid == $playerUid",
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".write": "auth != null && auth.uid == $playerUid",
              ".validate": "newData.isNumber() && newData.val() <= now + 10000"
            }
          }
        },
        "game": {
          ".read": false,
          ".write": false,
          "public": {
            ".read": "auth != null && (root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())"
          },
          "private": {
            "$playerUid": {".read": "auth != null && auth.uid == $playerUid"}
          },
          "server": {".read": false, ".write": false}
        }
      }
    }
  }
}
