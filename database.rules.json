{
  "rules": {
    ".read": false,
    ".write": false,
    "controllerRooms": {
      ".read": false,
      ".write": false
    },
    "roomCreateRequests": {
      ".read": false,
      ".write": false
    },
    "rooms": {
      ".indexOn": [
        "controllerPresence/lastSeen",
        "cleanupAt",
        "status"
      ],
      "$roomCode": {
        ".write": false,
        "roomCode": {
          ".read": "auth != null"
        },
        "controllerUid": {
          ".read": "auth != null && (data.val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())"
        },
        "controllerSessionId": {
          ".read": false,
          ".write": false
        },
        "createdAt": {
          ".read": "auth != null"
        },
        "roomInstanceId": {
          ".read": "auth != null",
          ".write": false
        },
        "membershipRevision": {
          ".read": "auth != null",
          ".write": false
        },
        "controllerCurrentConnectionId": {
          ".read": "auth != null",
          ".write": false
        },
        "controllerConnectionSeq": {
          ".read": "auth != null",
          ".write": false
        },
        "sessionOperations": {
          ".read": false,
          ".write": false
        },
        "connections": {
          ".read": false,
          "$connectionUid": {
            "$connectionId": {
              ".read": "auth != null && auth.uid == $connectionUid",
              ".validate": "newData.child('roomInstanceId').val() == data.child('roomInstanceId').val() && newData.child('connectionSeq').val() == data.child('connectionSeq').val() && newData.child('membershipId').val() == data.child('membershipId').val()",
              "connected": {
                ".write": "auth != null && auth.uid == $connectionUid && newData.isBoolean() && root.child('rooms').child($roomCode).child('status').exists() && root.child('rooms').child($roomCode).child('status').val() != 'closed' && root.child('rooms').child($roomCode).child('status').val() != 'terminal' && root.child('rooms').child($roomCode).child('connections').child($connectionUid).child($connectionId).child('roomInstanceId').val() == root.child('rooms').child($roomCode).child('roomInstanceId').val() && ((root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid && root.child('rooms').child($roomCode).child('controllerCurrentConnectionId').val() == $connectionId) || (root.child('rooms').child($roomCode).child('players').child(auth.uid).child('status').val() == 'active' && root.child('rooms').child($roomCode).child('players').child(auth.uid).child('currentConnectionId').val() == $connectionId && root.child('rooms').child($roomCode).child('players').child(auth.uid).child('membershipId').val() == root.child('rooms').child($roomCode).child('connections').child(auth.uid).child($connectionId).child('membershipId').val()))"
              },
              "lastSeen": {
                ".write": "auth != null && auth.uid == $connectionUid && newData.isNumber() && newData.val() <= now + 10000 && root.child('rooms').child($roomCode).child('status').exists() && root.child('rooms').child($roomCode).child('status').val() != 'closed' && root.child('rooms').child($roomCode).child('status').val() != 'terminal' && root.child('rooms').child($roomCode).child('connections').child($connectionUid).child($connectionId).child('roomInstanceId').val() == root.child('rooms').child($roomCode).child('roomInstanceId').val() && ((root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid && root.child('rooms').child($roomCode).child('controllerCurrentConnectionId').val() == $connectionId) || (root.child('rooms').child($roomCode).child('players').child(auth.uid).child('status').val() == 'active' && root.child('rooms').child($roomCode).child('players').child(auth.uid).child('currentConnectionId').val() == $connectionId && root.child('rooms').child($roomCode).child('players').child(auth.uid).child('membershipId').val() == root.child('rooms').child($roomCode).child('connections').child(auth.uid).child($connectionId).child('membershipId').val()))"
              },
              "$other": {
                ".write": false
              }
            }
          }
        },
        "status": {
          ".read": "auth != null && (root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())",
          ".write": false
        },
        "controllerConnected": {
          ".read": "auth != null",
          ".write": false
        },
        "controllerPresence": {
          ".read": "auth != null && (root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())",
          ".write": false,
          ".validate": "newData.hasChildren(['connected', 'lastSeen']) && newData.child('connected').isBoolean() && newData.child('lastSeen').isNumber() && newData.child('lastSeen').val() <= now + 10000"
        },
        "maxPlayers": {
          ".read": "auth != null"
        },
        "selectedGame": {
          ".read": "auth != null",
          ".write": false
        },
        "players": {
          ".read": "auth != null",
          "$playerUid": {
            ".write": false,
            "nickname": {
              ".write": false,
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12"
            },
            "characterId": {
              ".write": false,
              ".validate": "newData.isString() && newData.val().matches(/^(burger|cone|popcorn|bucket|pot|parcel|watermelon|capmask|hood|scarf|astronaut|welder|catcher|goggles|disguise|bandage|tissue|milk|cupnoodle|lampshade|bear|bee|cat|crab|deer|elephant|frog|giraffe|hedgehog|kindbear|octopus|owl|penguin|rabbit|shark|snake|whale)$/)"
            },
            "isConnected": {
              ".write": false,
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".write": false,
              ".validate": "newData.isNumber() && newData.val() <= now + 10000"
            }
          }
        },
        "game": {
          ".read": false,
          ".write": false,
          "public": {
            ".read": "auth != null && (root.child('rooms').child($roomCode).child('controllerUid').val() == auth.uid || root.child('rooms').child($roomCode).child('players').child(auth.uid).exists())"
          },
          "private": {
            "$playerUid": {
              ".read": "auth != null && auth.uid == $playerUid"
            }
          },
          "server": {
            ".read": false,
            ".write": false
          }
        }
      }
    },
    "roomCreateSlots": {
      ".read": false,
      ".write": false
    },
    "roomCleanupScan": {
      ".read": false,
      ".write": false
    },
    "roomCleanupQueue": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "nextCheckAt"
      ]
    }
  }
}
