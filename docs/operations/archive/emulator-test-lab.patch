+
+test('response loss after fixture creation still cleans only its owned paths', async () => {
+  const fake = backend({ failAfterRoomWrite: true });
+  const result = await probeRtdbTriggers(fake);
+  assert.equal(result.status, 'FAIL');
+  assert.deepEqual(fake.contents(), { room: null, reservation: null });
+  assert.deepEqual(result.cleanup, { roomRemoved: true, reservationRemoved: true });
+});
+
+test('even a matching marker never authorizes deleting a pre-existing unclaimed reservation', async () => {
+  const fake = backend({ collisionReservation: true });
