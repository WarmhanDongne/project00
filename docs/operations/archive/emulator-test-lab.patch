@@ -0,0 +1,118 @@
+import assert from "node:assert/strict";
+import {spawnSync} from "node:child_process";
+import test from "node:test";
+import {fileURLToPath} from "node:url";
+
+import {selectDatabaseTriggerRegion} from "../lib/emulator-test-config.js";
+
+const approved = {
+  FUNCTIONS_EMULATOR: "true",
+  GCLOUD_PROJECT: "demo-mosigame-lab",
+  FIREBASE_DATABASE_EMULATOR_HOST: "127.0.0.1:9000",
+};
+
+test("ordinary deployment discovery retains Singapore without emulator markers", () => {
+  for (const environment of [{}, {GCLOUD_PROJECT: "project0000-ec01e"}, {
+    GCLOUD_PROJECT: "demo-mosigame-lab",
+    FIREBASE_CONFIG: JSON.stringify({projectId: "demo-mosigame-lab"}),
+  }]) {
+    assert.equal(selectDatabaseTriggerRegion(environment), "asia-southeast1");
+  }
+});
+
+test("approved local environment supports Firebase CLI loopback endpoint formats", () => {
+  for (const host of ["127.0.0.1:9000", "localhost:9000", "[::1]:9000", "localhost:65535"]) {
+    assert.equal(selectDatabaseTriggerRegion({
+      ...approved, FIREBASE_DATABASE_EMULATOR_HOST: host,
+      FIREBASE_CONFIG: JSON.stringify({projectId: "demo-mosigame-lab"}),
+    }), "us-central1");
+  }
+});
+
+test("partial emulator settings and conflicting project identifiers fail closed", () => {
+  for (const patch of [
+    {FUNCTIONS_EMULATOR: undefined}, {FUNCTIONS_EMULATOR: "false"},
+    {FUNCTIONS_EMULATOR: "TRUE"}, {GCLOUD_PROJECT: undefined},
+    {GCLOUD_PROJECT: "project0000-ec01e"}, {GCLOUD_PROJECT: "demo-another-lab"},
+    {FIREBASE_DATABASE_EMULATOR_HOST: undefined}, {GCP_PROJECT: "another-project"},
+    {GOOGLE_CLOUD_PROJECT: "another-project"},
+    {FIREBASE_CONFIG: JSON.stringify({projectId: "project0000-ec01e"})},
+    {FIREBASE_CONFIG: "invalid-json"}, {FIREBASE_CONFIG: "[]"},
+    {FIREBASE_CONFIG: "{}"}, {FIREBASE_CONFIG: "null"},
+  ]) {
+    assert.throws(() => selectDatabaseTriggerRegion({...approved, ...patch}), /RTDB emulator test/);
+  }
+  assert.throws(() => selectDatabaseTriggerRegion({FUNCTIONS_EMULATOR: "true"}), /RTDB emulator test/);
+});
+
+test("remote, wildcard, malformed and out-of-range database endpoints fail closed", () => {
+  for (const host of [
+    "0.0.0.0:9000", "10.0.2.2:9000", "192.168.1.2:9000", "example.com:9000",
+    "localhost.example.com:9000", "https://localhost:9000", "localhost:0",
+    "localhost:65536", "localhost:09000", "localhost:9000/path", "localhost:9000?ns=x",
+    "localhost:9000 ", "user@localhost:9000", "::1:9000", "", "localhost",
+  ]) {
+    assert.throws(() => selectDatabaseTriggerRegion({
+      ...approved, FIREBASE_DATABASE_EMULATOR_HOST: host,
+    }), /RTDB emulator test/);
+  }
+});
+
+// Inspect the real exported endpoint metadata in separate, clean processes.
+// No handler runs and no Admin SDK read/write or deploy occurs.
+function discoverEndpoints(extraEnvironment) {
+  const environment = {...process.env};
+  for (const key of Object.keys(environment)) {
+    if (key.startsWith("FIREBASE_") || key.endsWith("EMULATOR_HOST") ||
+        ["FUNCTIONS_EMULATOR", "GCLOUD_PROJECT", "GCP_PROJECT", "GOOGLE_CLOUD_PROJECT",
+          "GOOGLE_APPLICATION_CREDENTIALS"].includes(key)) delete environment[key];
+  }
+  const result = spawnSync(process.execPath, ["--input-type=module", "-e", `
+    const exported = await import("./lib/index.js");
+    const endpoints = {};
+    for (const [name, fn] of Object.entries(exported)) {
+      if (fn?.__endpoint) endpoints[name] = fn.__endpoint;
+    }
+    process.stdout.write(JSON.stringify(endpoints));
+  `], {
+    cwd: fileURLToPath(new URL("..", import.meta.url)),
+    env: {...environment, ...extraEnvironment}, encoding: "utf8", timeout: 30_000,
+  });
+  assert.equal(result.error, undefined, result.error?.message);
+  assert.equal(result.status, 0, result.stderr);
+  return JSON.parse(result.stdout);
+}
+
+test("real discovery changes exactly four RTDB regions and preserves every other endpoint", () => {
+  const production = discoverEndpoints({GCLOUD_PROJECT: "project0000-ec01e"});
+  const emulator = discoverEndpoints({
+    ...approved,
+    FIREBASE_CONFIG: JSON.stringify({
+      projectId: "demo-mosigame-lab", databaseURL: "http://127.0.0.1:9000/?ns=demo-mosigame-lab",
+    }),
+  });
+  const triggers = [
+    "cleanupDeletedRoomCreationRequest", "game_common_controller_presence_changed",
+    "game_common_interruption_on_connection_changed", "syncRealtimeRoomGameStatus",
+  ];
+  assert.deepEqual(Object.keys(production).sort(), Object.keys(emulator).sort());
+  assert.equal(Object.keys(production).length, 69);
+  const changed = [];
+  for (const name of Object.keys(production)) {
+    const ordinary = production[name];
+    const local = emulator[name];
+    if (triggers.includes(name)) {
+      assert.equal(ordinary.eventTrigger.eventType.startsWith("google.firebase.database."), true);
+      assert.deepEqual(ordinary.region, ["asia-southeast1"]);
+      assert.deepEqual(local.region, ["us-central1"]);
+      changed.push(name);
+      const {region: ordinaryRegion, ...ordinaryRest} = ordinary;
+      const {region: localRegion, ...localRest} = local;
+      assert.deepEqual(localRest, ordinaryRest);
+    } else {
+      assert.deepEqual(local, ordinary, name);
+      assert.deepEqual(local.region, ["asia-northeast3"], name);
+    }
+  }
+  assert.deepEqual(changed.sort(), triggers.sort());
+});
