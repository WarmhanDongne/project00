+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { deflateSync } from 'node:zlib';
+import { parseRequest, resolveCaptureTarget, verifyPng } from './adb_controller.mjs';
+
+function withFixture(callback) {
+  const tempRoot = path.resolve(os.tmpdir());
+  const root = mkdtempSync(path.join(tempRoot, 'mosigame-adb-'));
+  try { callback(root); } finally {
+    assert.equal(path.dirname(root), tempRoot);
+    assert.ok(path.basename(root).startsWith('mosigame-adb-'));
+    rmSync(root, { recursive: true, force: true });
+  }
+}
+
+test('rejects physical serials and arbitrary shell actions', () => {
+  assert.throws(() => parseRequest(['tap', 'R58DEVICE', '10', '20']));
+  assert.throws(() => parseRequest(['shell', 'emulator-5580', 'rm', '-rf']));
+  assert.throws(() => parseRequest(['home', 'emulator-5580', 'extra']));
+  assert.throws(() => parseRequest(['tap', 'emulator-5580', '-1', '20']));
+  assert.throws(() => parseRequest(['tap', 'emulator-5580', '10;echo', '20']));
+  assert.deepEqual(parseRequest(['tap', 'emulator-5580', '10', '20']), {
+    action: 'tap', args: ['emulator-5580', '10', '20'],
+  });
+});
+
+test('captures cannot overwrite files or escape the evidence directory', () => withFixture((root) => {
+  mkdirSync(path.join(root, 'build', 'emulator_lab'), { recursive: true });
+  assert.throws(() => resolveCaptureTarget(root, '../outside.png'));
+  assert.throws(() => resolveCaptureTarget(root, 'lib/changed.png'));
+  assert.throws(() => resolveCaptureTarget(root, 'build/emulator_lab/shot.txt'));
+  writeFileSync(path.join(root, 'build/emulator_lab/existing.png'), 'evidence');
+  assert.throws(() => resolveCaptureTarget(root, 'build/emulator_lab/existing.png'));
+  assert.equal(resolveCaptureTarget(root, 'build/emulator_lab/run/shot.png'),
+    path.join(root, 'build/emulator_lab/run/shot.png'));
+}));
+
+test('rejects junctions that redirect captures into source directories', () => withFixture((root) => {
+  mkdirSync(path.join(root, 'build', 'emulator_lab'), { recursive: true });
+  mkdirSync(path.join(root, 'lib'));
+  symlinkSync(path.join(root, 'lib'), path.join(root, 'build/emulator_lab/redirect'),
+    process.platform === 'win32' ? 'junction' : 'dir');
+  assert.throws(() => resolveCaptureTarget(root, 'build/emulator_lab/redirect/source.png'));
+}));
+
+test('rejects incomplete screenshots rather than reporting a capture success', () => {
+  const header = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);
+  function chunk(name, data) {
+    const result = Buffer.alloc(12 + data.length);
+    result.writeUInt32BE(data.length);
+    result.write(name, 4, 'ascii');
+    data.copy(result, 8);
+    return result;
+  }
+  const ihdr = Buffer.alloc(13);
+  ihdr.writeUInt32BE(1, 0);
+  ihdr.writeUInt32BE(1, 4);
+  ihdr[8] = 8;
+  ihdr[9] = 6;
+  const correct = Buffer.concat([header, chunk('IHDR', ihdr),
+    chunk('IDAT', deflateSync(Buffer.from([0, 1, 2, 3, 255]))), chunk('IEND', Buffer.alloc(0))]);
+  assert.doesNotThrow(() => verifyPng(correct));
+  assert.throws(() => verifyPng(correct.subarray(0, 50)));
+  const empty = Buffer.concat([header, chunk('IHDR', ihdr),
+    chunk('IDAT', deflateSync(Buffer.alloc(0))), chunk('IEND', Buffer.alloc(0))]);
+  assert.throws(() => verifyPng(empty));
+});
