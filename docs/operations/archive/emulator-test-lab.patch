diff --git a/lib/firebase/emulator_lab.dart b/lib/firebase/emulator_lab.dart
new file mode 100644
--- /dev/null
+++ b/lib/firebase/emulator_lab.dart
@@ -0,0 +1,45 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:cloud_functions/cloud_functions.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import 'package:firebase_core/firebase_core.dart';
+import 'package:firebase_database/firebase_database.dart';
+import 'package:firebase_storage/firebase_storage.dart';
+import 'package:game_kit/firebase/services/realtime_database_service.dart';
+import 'package:project00/firebase/emulator_lab_config.dart';
+
+/// Connect all SDKs before AuthGate, ServerClock or any repository is created.
+Future<void> connectEmulatorLab() async {
+  if (!EmulatorLabConfig.enabled ||
+      Firebase.apps.length != 1 ||
+      Firebase.app().options.projectId != EmulatorLabConfig.projectId) {
+    throw StateError('Emulator lab Firebase isolation check failed');
+  }
+  const host = EmulatorLabConfig.host;
+  await FirebaseAuth.instance.useAuthEmulator(
+    host,
+    9099,
+    automaticHostMapping: false,
+  );
+  FirebaseFirestore.instance.useFirestoreEmulator(
+    host,
+    8080,
+    automaticHostMapping: false,
+  );
+  FirebaseDatabase.instance.useDatabaseEmulator(
+    host,
+    9000,
+    automaticHostMapping: false,
+  );
+  final sharedDatabase = RealtimeDatabaseService.instance;
+  if (!identical(sharedDatabase, FirebaseDatabase.instance)) {
+    sharedDatabase.useDatabaseEmulator(host, 9000, automaticHostMapping: false);
+  }
+  FirebaseFunctions.instanceFor(
+    region: 'asia-northeast3',
+  ).useFunctionsEmulator(host, 5001, automaticHostMapping: false);
+  await FirebaseStorage.instance.useStorageEmulator(
+    host,
+    9199,
+    automaticHostMapping: false,
+  );
+}
diff --git a/lib/firebase/emulator_lab_config.dart b/lib/firebase/emulator_lab_config.dart
new file mode 100644
--- /dev/null
+++ b/lib/firebase/emulator_lab_config.dart
@@ -0,0 +1,31 @@
+import 'package:firebase_core/firebase_core.dart';
+
+/// Internal, opt-in configuration for isolated Android baseline tests.
+abstract final class EmulatorLabConfig {
+  static const flag = String.fromEnvironment('MOSIGAME_EMULATOR_LAB');
+  static const enabled = flag == 'true';
+  static const projectId = 'demo-mosigame-lab';
+  static const host = '10.0.2.2';
+
+  static const options = FirebaseOptions(
+    apiKey: 'AIzaSyEmulatorOnly00000000000000000000000',
+    appId: '1:123456789012:android:0123456789abcdef012345',
+    messagingSenderId: '123456789012',
+    projectId: projectId,
+    databaseURL: 'https://demo-mosigame-lab-default-rtdb.firebaseio.com',
+    storageBucket: 'demo-mosigame-lab.appspot.com',
+  );
+
+  static void validate({
+    required String requestedFlag,
+    required bool debug,
+    required bool android,
+  }) {
+    if (!const ['', 'false', 'true'].contains(requestedFlag)) {
+      throw StateError('Invalid MOSIGAME_EMULATOR_LAB flag');
+    }
+    if (requestedFlag == 'true' && (!debug || !android)) {
+      throw StateError('Emulator lab requires a debug Android build');
+    }
+  }
+}
diff --git a/functions/src/emulator-test-config.ts b/functions/src/emulator-test-config.ts
new file mode 100644
--- /dev/null
+++ b/functions/src/emulator-test-config.ts
@@ -0,0 +1,63 @@
+const DATABASE_TRIGGER_REGION = "asia-southeast1";
+const EMULATOR_DATABASE_TRIGGER_REGION = "us-central1";
+const EMULATOR_TEST_PROJECT = "demo-mosigame-lab";
+
+/**
+ * Keeps deployment discovery unchanged and confines the local RTDB workaround.
+ * Firebase CLI supplies these variables during both discovery and invocation.
+ *
+ * @param {Object<string, (string|undefined)>} environment Runtime environment.
+ * @return {string} The production region or the approved local-only region.
+ */
+export function selectDatabaseTriggerRegion(
+  environment: Record<string, string | undefined> = process.env,
+): string {
+  const flag = environment.FUNCTIONS_EMULATOR;
+  const databaseHost = environment.FIREBASE_DATABASE_EMULATOR_HOST;
+  if (flag === undefined && databaseHost === undefined) {
+    return DATABASE_TRIGGER_REGION;
+  }
+
+  if (flag !== "true" ||
+      environment.GCLOUD_PROJECT !== EMULATOR_TEST_PROJECT ||
+      !isLoopbackDatabaseEndpoint(databaseHost)) {
+    throw new Error(
+      "RTDB emulator test requires the approved local environment",
+    );
+  }
+  for (const projectKey of ["GCP_PROJECT", "GOOGLE_CLOUD_PROJECT"]) {
+    const project = environment[projectKey];
+    if (project !== undefined && project !== EMULATOR_TEST_PROJECT) {
+      throw new Error("RTDB emulator test project identifiers must agree");
+    }
+  }
+
+  if (environment.FIREBASE_CONFIG !== undefined) {
+    let config: unknown;
+    try {
+      config = JSON.parse(environment.FIREBASE_CONFIG);
+    } catch {
+      throw new Error("RTDB emulator test requires a valid Firebase config");
+    }
+    const firebaseProject = (config as {projectId?: unknown} | null)?.projectId;
+    if (!config || typeof config !== "object" || Array.isArray(config) ||
+        firebaseProject !== EMULATOR_TEST_PROJECT) {
+      throw new Error(
+        "RTDB emulator test Firebase config project must agree",
+      );
+    }
+  }
+  return EMULATOR_DATABASE_TRIGGER_REGION;
+}
+
+/**
+ * Accepts only explicit loopback hosts and valid ports, without DNS resolution.
+ *
+ * @param {string|undefined} endpoint Admin SDK host:port emulator setting.
+ * @return {boolean} Whether this is an allowlisted local endpoint.
+ */
+function isLoopbackDatabaseEndpoint(endpoint: string | undefined): boolean {
+  const match = /^(?:localhost|127\.0\.0\.1|\[::1\]):([1-9][0-9]{0,4})$/
+    .exec(endpoint ?? "");
+  return match !== null && Number(match[1]) <= 65535;
+}
