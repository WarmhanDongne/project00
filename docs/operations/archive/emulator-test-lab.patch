diff --git a/tool/emulator_lab/adb_controller.mjs b/tool/emulator_lab/adb_controller.mjs
new file mode 100644
--- /dev/null
+++ b/tool/emulator_lab/adb_controller.mjs
@@ -0,0 +1,149 @@
+import { spawnSync } from 'node:child_process';
+import { existsSync, lstatSync, mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';
+import { randomUUID } from 'node:crypto';
+import { inflateSync } from 'node:zlib';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const repositoryRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+const sdkRoot = process.env.ANDROID_SDK_ROOT || process.env.ANDROID_HOME ||
+  path.join(process.env.LOCALAPPDATA || '', 'Android', 'Sdk');
+const adb = path.join(sdkRoot, 'platform-tools', process.platform === 'win32' ? 'adb.exe' : 'adb');
+
+function run(args, binary = false) {
+  if (!existsSync(adb)) throw new Error('ADB_NOT_FOUND');
+  const result = spawnSync(adb, args, {
+    timeout: 20000, windowsHide: true,
+    encoding: binary ? null : 'utf8', maxBuffer: 32 * 1024 * 1024,
+  });
+  if (result.error) throw result.error;
+  if (result.status !== 0) throw new Error('ADB_COMMAND_FAILED');
+  return result.stdout;
+}
+
+export function parseRequest(argv) {
+  const [action, ...args] = argv;
+  const allowed = new Set(['devices', 'capture', 'tap', 'home', 'back']);
+  if (!allowed.has(action)) throw new Error('Unsupported action');
+  const expected = { devices: 0, capture: 2, tap: 3, home: 1, back: 1 }[action];
+  if (args.length !== expected) throw new Error('Invalid argument count');
+  if (action !== 'devices' && !/^emulator-[0-9]{4,5}$/.test(args[0])) {
+    throw new Error('Only an exact Android emulator serial is allowed');
+  }
+  if (action === 'tap') {
+    for (const value of args.slice(1)) {
+      if (!/^[0-9]+$/.test(value) || Number(value) > 8192) {
+        throw new Error('Invalid screen coordinate');
+      }
+    }
+  }
+  return { action, args };
+}
+
+function verifyEmulator(serial) {
+  const rows = run(['devices']).split(/\r?\n/).map((row) => row.trim().split(/\s+/));
+  if (!rows.some(([id, state]) => id === serial && state === 'device')) {
+    throw new Error('Emulator is not connected and ready');
+  }
+  if (run(['-s', serial, 'shell', 'getprop', 'ro.kernel.qemu']).trim() !== '1') {
+    throw new Error('Target is not an Android emulator');
+  }
+}
+
+export function resolveCaptureTarget(root, requested) {
+  const artifactRoot = path.resolve(root, 'build', 'emulator_lab');
+  const resolved = path.resolve(root, requested);
+  const relative = path.relative(artifactRoot, resolved);
+  if (!relative || relative.startsWith('..') || path.isAbsolute(relative) ||
+      path.extname(resolved).toLowerCase() !== '.png') {
+    throw new Error('Capture must be a PNG inside build/emulator_lab');
+  }
+  // Follow existing directories before creating anything, to reject escaped junctions.
+  let existing = path.dirname(resolved);
+  while (!existsSync(existing)) existing = path.dirname(existing);
+  for (let ancestor = existing; ancestor !== path.dirname(ancestor); ancestor = path.dirname(ancestor)) {
+    if (lstatSync(ancestor).isSymbolicLink()) throw new Error('Capture parent is a symbolic link or junction');
+    if (ancestor === path.resolve(root)) break;
+  }
+  const realExisting = realpathSync(existing);
+  const realRoot = realpathSync(root);
+  const realRelative = path.relative(realRoot, realExisting);
+  if (realRelative.startsWith('..') || path.isAbsolute(realRelative)) {
+    throw new Error('Capture parent resolves outside the repository');
+  }
+  if (existsSync(resolved)) throw new Error('Capture output already exists');
+  return resolved;
+}
+
+export function verifyPng(bytes) {
+  const signature = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);
+  if (!bytes.subarray(0, 8).equals(signature) || bytes.length < 33) {
+    throw new Error('Capture is not a PNG');
+  }
+  const width = bytes.readUInt32BE(16);
+  const height = bytes.readUInt32BE(20);
+  const channels = { 2: 3, 6: 4 }[bytes[25]];
+  if (!width || !height || width * height > 16000000 || bytes[24] !== 8 ||
+      !channels || bytes[28] !== 0) throw new Error('Unsupported PNG dimensions or encoding');
+  const chunks = [];
+  let ended = false;
+  for (let offset = 8; offset + 12 <= bytes.length;) {
+    const length = bytes.readUInt32BE(offset);
+    if (offset + length + 12 > bytes.length) throw new Error('Incomplete PNG chunk');
+    const type = bytes.toString('ascii', offset + 4, offset + 8);
+    if (type === 'IDAT') chunks.push(bytes.subarray(offset + 8, offset + 8 + length));
+    if (type === 'IEND') { ended = true; break; }
+    offset += length + 12;
+  }
+  const expected = height * (width * channels + 1);
+  if (!ended || !chunks.length ||
+      inflateSync(Buffer.concat(chunks), { maxOutputLength: expected }).length !== expected) {
+    throw new Error('Incomplete PNG pixel data');
+  }
+}
+
+function capture(serial, target) {
+  mkdirSync(path.dirname(target), { recursive: true });
+  const temporary = mkdtempSync(path.join(path.dirname(target), '.capture-'));
+  const remote = '/sdcard/emulator-lab-' + randomUUID() + '.png';
+  try {
+    run(['-s', serial, 'shell', 'screencap', '-p', remote]);
+    run(['-s', serial, 'pull', remote, path.join(temporary, 'screen.png')]);
+    const bytes = readFileSync(path.join(temporary, 'screen.png'));
+    verifyPng(bytes);
+    writeFileSync(target, bytes, { flag: 'wx' });
+  } finally {
+    // These exact paths were newly created by this capture operation.
+    if (path.dirname(temporary) !== path.dirname(target)) throw new Error('Unexpected temporary path');
+    rmSync(temporary, { recursive: true, force: true });
+    run(['-s', serial, 'shell', 'rm', remote]);
+  }
+}
+
+function main() {
+  const request = parseRequest(process.argv.slice(2));
+  if (request.action === 'devices') {
+    const emulatorRows = run(['devices']).split(/\r?\n/).filter((row) => /^emulator-\d+\s/.test(row));
+    process.stdout.write(JSON.stringify({ emulators: emulatorRows }) + '\n');
+    return;
+  }
+  const [serial, ...args] = request.args;
+  verifyEmulator(serial);
+  if (request.action === 'capture') {
+    const target = resolveCaptureTarget(repositoryRoot, args[0]);
+    capture(serial, target);
+    process.stdout.write(JSON.stringify({ status: 'CAPTURED', path: target }) + '\n');
+  } else {
+    const actionArgs = request.action === 'tap' ? ['tap', ...args] :
+      ['keyevent', request.action === 'home' ? 'KEYCODE_HOME' : 'KEYCODE_BACK'];
+    run(['-s', serial, 'shell', 'input', ...actionArgs]);
+    process.stdout.write(JSON.stringify({ status: 'ACTION_SENT', action: request.action }) + '\n');
+  }
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try { main(); } catch (error) {
+    process.stderr.write(String(error.message) + '\n');
+    process.exitCode = 1;
+  }
+}
