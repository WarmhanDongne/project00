+++ b/tool/emulator_lab/local_backend.mjs
@@ -0,0 +1,323 @@
+import { spawn } from 'node:child_process';
+import { createRequire } from 'node:module';
+import { createInterface } from 'node:readline';
+import { existsSync, mkdirSync, readFileSync, realpathSync, writeFileSync } from 'node:fs';
+import { randomUUID } from 'node:crypto';
+import net from 'node:net';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export const repositoryRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+export const PROJECT_ID = 'demo-mosigame-lab';
+export const LAB_DATABASE_URL = `https://${PROJECT_ID}-default-rtdb.firebaseio.com`;
+export const LAB_PORTS = Object.freeze({ auth: 9099, database: 9000, firestore: 8080, functions: 5001, storage: 9199, hub: 4400, logging: 4500, eventarc: 9299, tasks: 9499 });
+export const LAB_PASSWORD = 'MosigameLab!2026';
+export const LAB_ROLES = Object.freeze(['T', 'A', 'B', 'C', 'D', 'X']);
+export const DISCOVERY_TIMEOUT_SECONDS = 60;
+const runtimeDirectory = path.join(repositoryRoot, '.firebase', 'emulator-lab');
+const requireFunctions = createRequire(path.join(repositoryRoot, 'functions', 'package.json'));
+
+export function labTargets() {
+  return {
+    projectId: PROJECT_ID,
+    databaseURL: `http://127.0.0.1:${LAB_PORTS.database}/?ns=${PROJECT_ID}-default-rtdb`,
+    hosts: Object.fromEntries(Object.entries(LAB_PORTS).map(([name, port]) => [name, `127.0.0.1:${port}`])),
+  };
+}
+
+// Deliberately exact rather than accepting arbitrary demo projects or hosts.
+export function assertLocalTargets(targets) {
+  const expected = labTargets();
+  if (targets?.projectId !== PROJECT_ID || targets.databaseURL !== expected.databaseURL) {
+    throw new Error('LAB_PROJECT_OR_NAMESPACE_REJECTED');
+  }
+  for (const name of Object.keys(LAB_PORTS)) {
+    if (targets.hosts?.[name] !== expected.hosts[name]) throw new Error('LAB_ENDPOINT_REJECTED');
+  }
+  return targets;
+}
+
+export function createLabConfig(root = repositoryRoot) {
+  const configRoot = path.join(root, '.firebase', 'emulator-lab');
+  const config = {
+    functions: [{ source: path.relative(configRoot, path.join(root, 'functions')).replaceAll('\\', '/'), configDir: '.', codebase: 'default', disallowLegacyRuntimeConfig: true }],
+    database: { rules: path.join(root, 'database.rules.json') },
+    firestore: { rules: path.join(root, 'firestore.rules') },
+    storage: { rules: path.join(root, 'storage.rules') },
+    emulators: {
+      ...Object.fromEntries(Object.entries(LAB_PORTS).map(([name, port]) => [name, { host: '127.0.0.1', port }])),
+      ui: { enabled: false },
+      singleProjectMode: true,
+    },
+  };
+  return config;
+}
+
+export function assertLabConfig(config, configPath, root = repositoryRoot) {
+  const configRoot = path.dirname(configPath);
+  const source = config?.functions;
+  if (!Array.isArray(source) || source.length !== 1 || source[0].codebase !== 'default' ||
+      path.resolve(configRoot, source[0].source) !== path.join(root, 'functions') || source[0].configDir !== '.' || source[0].predeploy) {
+    throw new Error('LAB_FUNCTIONS_SOURCE_REJECTED');
+  }
+  for (const [name, file] of [['database', 'database.rules.json'], ['firestore', 'firestore.rules'], ['storage', 'storage.rules']]) {
+    if (config[name]?.rules !== path.join(root, file)) throw new Error('LAB_RULES_PATH_REJECTED');
+  }
+  for (const [name, port] of Object.entries(LAB_PORTS)) {
+    if (config.emulators?.[name]?.host !== '127.0.0.1' || config.emulators[name].port !== port) {
+      throw new Error('LAB_BIND_REJECTED');
+    }
+  }
+  if (config.emulators?.singleProjectMode !== true || config.emulators.ui?.enabled !== false ||
+      config.hosting || config.flutter) throw new Error('LAB_CONFIG_REJECTED');
+  return config;
+}
+
+export function writeLabConfig() {
+  const configPath = path.join(runtimeDirectory, 'firebase.json');
+  const config = assertLabConfig(createLabConfig(), configPath);
+  for (const file of ['database.rules.json', 'firestore.rules', 'storage.rules', 'functions/package.json', 'functions/node_modules/firebase-tools/lib/bin/firebase.js']) {
+    const expected = path.join(repositoryRoot, file);
+    if (!existsSync(expected) || realpathSync(expected) !== expected) throw new Error('LAB_REQUIRED_FILE_MISSING_OR_REDIRECTED');
+  }
+  mkdirSync(runtimeDirectory, { recursive: true });
+  writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
+  return configPath;
+}
+
+export function createLabEnvironment(inherited = process.env) {
+  // Exclude credential-bearing variables instead of inspecting or displaying them.
+  const env = Object.fromEntries(Object.entries(inherited).filter(([name]) =>
+    !/^(GOOGLE_APPLICATION_CREDENTIALS|GOOGLE_OAUTH_ACCESS_TOKEN|FIREBASE_TOKEN|FIREBASE_CONFIG|CLOUDSDK_AUTH_ACCESS_TOKEN|GCLOUD_PROJECT|GOOGLE_CLOUD_PROJECT|DATABASE_URL|FIREBASE_.*EMULATOR.*|FIREBASE_CLI_EXPERIMENTS)$/i.test(name)));
+  return {
+    ...env,
+    XDG_CONFIG_HOME: path.join(runtimeDirectory, 'cli-config'),
+    FIREBASE_CLI_DISABLE_UPDATE_CHECK: 'true',
+    // Installed firebase-tools reads this exact name, expressed in seconds.
+    FUNCTIONS_DISCOVERY_TIMEOUT: String(DISCOVERY_TIMEOUT_SECONDS),
+    GCLOUD_PROJECT: PROJECT_ID,
+    GOOGLE_CLOUD_PROJECT: PROJECT_ID,
+    // firebase-tools' demo-project Admin SDK config otherwise uses the older
+    // project-id namespace, while its rules config uses project-id-default-rtdb.
+    // This SDK selector is converted by CLI to the loopback emulator URL.
+    DATABASE_URL: LAB_DATABASE_URL,
+    FIREBASE_AUTH_EMULATOR_HOST: labTargets().hosts.auth,
+    FIREBASE_DATABASE_EMULATOR_HOST: labTargets().hosts.database,
+    FIRESTORE_EMULATOR_HOST: labTargets().hosts.firestore,
+    FIREBASE_STORAGE_EMULATOR_HOST: labTargets().hosts.storage,
+  };
+}
+
+export function firebaseStartArguments(configPath) {
+  assertLabConfig(JSON.parse(readFileSync(configPath, 'utf8')), configPath);
+  return [
+    path.join(repositoryRoot, 'functions', 'node_modules', 'firebase-tools', 'lib', 'bin', 'firebase.js'),
+    'emulators:start', '--project', PROJECT_ID, '--config', configPath,
+    '--only', 'auth,database,firestore,functions,storage', '--non-interactive',
+  ];
+}
+
+async function requireVacantPorts() {
+  for (const port of Object.values(LAB_PORTS)) {
+    await new Promise((resolve, reject) => {
+      const server = net.createServer();
+      server.once('error', () => reject(new Error(`LAB_PORT_ALREADY_IN_USE_${port}`)));
+      server.listen(port, '127.0.0.1', () => server.close(resolve));
+    });
+  }
+}
+
+export async function localJson(url, { method = 'GET', body, headers = {}, expectedStatus = 200, timeoutMs = 10000 } = {}, fetchImpl = fetch) {
+  const parsed = new URL(url);
+  if (parsed.protocol !== 'http:' || parsed.hostname !== '127.0.0.1' || parsed.username || parsed.password ||
+      !Object.values(LAB_PORTS).includes(Number(parsed.port))) throw new Error('LAB_HTTP_TARGET_REJECTED');
+  if (![200, 401].includes(expectedStatus) || !Number.isInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 30000) {
+    throw new Error('LAB_HTTP_OPTIONS_REJECTED');
+  }
+  const result = await fetchImpl(parsed, {
+    method, redirect: 'error', signal: AbortSignal.timeout(timeoutMs),
+    headers: { 'Content-Type': 'application/json', ...headers },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  if (result.status !== expectedStatus) throw new Error(`LAB_HTTP_FAILED_${result.status}`);
+  return result.json();
+}
+
+export async function assertFunctionsLoaded(targets = labTargets(), request = localJson) {
+  assertLocalTargets(targets);
+  // createRealtimeRoom rejects missing auth before any Firestore/RTDB access.
+  // Probing without a token cannot create a room and proves handler discovery,
+  // whereas a listening Functions port or hub entry alone does not.
+  const response = await request(`http://${targets.hosts.functions}/${PROJECT_ID}/asia-northeast3/createRealtimeRoom`, {
+    method: 'POST', body: { data: {} }, expectedStatus: 401, timeoutMs: 30000,
+  });
+  if (response?.error?.status !== 'UNAUTHENTICATED') throw new Error('LAB_FUNCTIONS_PROBE_REJECTED');
+  return 'createRealtimeRoom:UNAUTHENTICATED';
+}
+
+export async function assertRunningLab(targets = labTargets(), request = localJson) {
+  assertLocalTargets(targets);
+  const mapping = await request(`http://${targets.hosts.hub}/emulators`);
+  for (const name of ['auth', 'database', 'firestore', 'functions', 'storage']) {
+    const expected = LAB_PORTS[name];
+    if (mapping[name]?.host !== '127.0.0.1' || mapping[name].port !== expected) {
+      throw new Error('LAB_RUNNING_ENDPOINT_REJECTED');
+    }
+  }
+  const functionProbe = await assertFunctionsLoaded(targets, request);
+  return { projectId: PROJECT_ID, services: ['auth', 'database', 'firestore', 'functions', 'storage'], functionProbe };
+}
+
+export function syntheticFixtures() {
+  const accounts = LAB_ROLES.map((role) => ({
+    role, uid: `mosigame-lab-${role}`, email: `${role.toLowerCase()}@example.test`,
+    password: LAB_PASSWORD, emailVerified: true, displayName: `Lab ${role}`,
+  }));
+  const games = [
+    { id: 'liars_poker', name: "Liar's Poker", minPlayers: 2, maxPlayers: 6, accessType: 'free' },
+    { id: 'final_call', name: 'Final Call', minPlayers: 4, maxPlayers: 4, accessType: 'paid' },
+    { id: 'mafia', name: 'Mafia', minPlayers: 4, maxPlayers: 12, accessType: 'paid' },
+  ].map((game, index) => ({ ...game, enabled: true, order: index, description: 'Synthetic local lab catalog',
+    tabletDescription: 'Synthetic local lab catalog', rules: 'Local lab fixture; use bundled game rules.',
+    imageUrl: '', componentImageUrl: '', ruleVideoUrl: '', genres: [], playTime: 20, minAppVersion: '' }));
+  const users = accounts.map(({ role, uid, email, displayName }) => ({
+    uid, email, nickname: displayName, profileImageUrl: null,
+    ownedGames: role === 'A' ? ['final_call', 'mafia'] : [],
+  }));
+  const onboarding = accounts.map(({ uid }) => ({ uid, status: 'complete', provider: 'legacyPassword', schemaVersion: 1 }));
+  return { accounts, games, users, onboarding };
+}
+
+export function firestoreFixtureValue(value) {
+  if (value === null) return { nullValue: null };
+  if (typeof value === 'string') return { stringValue: value };
+  if (typeof value === 'boolean') return { booleanValue: value };
+  if (Number.isSafeInteger(value)) return { integerValue: String(value) };
+  if (Array.isArray(value)) return { arrayValue: { values: value.map(firestoreFixtureValue) } };
+  throw new Error('LAB_FIRESTORE_FIXTURE_VALUE_REJECTED');
+}
+
+export function firestoreSeedWrites(fixtures = syntheticFixtures()) {
+  const document = (collection, id, data, timestampFields) => {
+    if (!['users', 'userOnboarding', 'games'].includes(collection) || !/^[A-Za-z0-9_-]{1,128}$/.test(id)) {
+      throw new Error('LAB_FIRESTORE_FIXTURE_PATH_REJECTED');
+    }
+    return {
+      update: {
+        name: `projects/${PROJECT_ID}/databases/(default)/documents/${collection}/${id}`,
+        fields: Object.fromEntries(Object.entries(data).map(([name, value]) => [name, firestoreFixtureValue(value)])),
+      },
+      updateTransforms: timestampFields.map((fieldPath) => ({ fieldPath, setToServerValue: 'REQUEST_TIME' })),
+    };
+  };
+  return [
+    ...fixtures.users.map((user) => document('users', user.uid, user, ['createdAt', 'updatedAt'])),
+    ...fixtures.onboarding.map((entry) => document('userOnboarding', entry.uid, entry, ['completedAt', 'updatedAt'])),
+    ...fixtures.games.map(({ id, ...game }) => document('games', id, game, ['createdAt', 'updatedAt'])),
+  ];
+}
+
+export async function seedLocalLab(targets = labTargets()) {
+  assertLocalTargets(targets);
+  await assertRunningLab(targets);
+  // Admin SDK is loaded only after the local target guards pass. No ADC lookup.
+  const env = createLabEnvironment();
+  for (const name of ['GCLOUD_PROJECT', 'GOOGLE_CLOUD_PROJECT', 'FIREBASE_AUTH_EMULATOR_HOST', 'FIREBASE_DATABASE_EMULATOR_HOST', 'FIRESTORE_EMULATOR_HOST', 'FIREBASE_STORAGE_EMULATOR_HOST']) {
+    process.env[name] = env[name];
+  }
+  const { initializeApp, deleteApp } = requireFunctions('firebase-admin/app');
+  const { getAuth } = requireFunctions('firebase-admin/auth');
+  const app = initializeApp({
+    projectId: PROJECT_ID, databaseURL: targets.databaseURL,
+    credential: { getAccessToken: async () => ({ access_token: 'owner', expires_in: 3600 }) },
+  }, `mosigame-lab-seed-${randomUUID()}`);
+  try {
+    const auth = getAuth(app);
+    const fixtures = syntheticFixtures();
+    for (const { role, ...account } of fixtures.accounts) {
+      try { await auth.createUser(account); } catch (error) {
+        if (error.code !== 'auth/uid-already-exists') throw new Error('LAB_SYNTHETIC_ACCOUNT_CREATE_FAILED');
+        await auth.updateUser(account.uid, account);
+      }
+    }
+    // firebase-admin/getFirestore requires ADC or a service account even for an
+    // emulator. The local REST commit accepts the emulator-only owner token;
+    // this avoids discovering or fabricating a Google credential entirely.
+    await localJson(`http://${targets.hosts.firestore}/v1/projects/${PROJECT_ID}/databases/(default)/documents:commit`, {
+      method: 'POST', headers: { Authorization: 'Bearer owner' }, body: { writes: firestoreSeedWrites(fixtures) },
+    });
+    return { status: 'PASS', projectId: PROJECT_ID, accountCount: fixtures.accounts.length, gameCount: fixtures.games.length };
+  } finally { await deleteApp(app); }
+}
+
+export async function startLocalLab() {
+  if (process.platform === 'win32' && process.env.MOSIGAME_LAB_JOB_OWNED !== '1') {
+    throw new Error('LAB_WINDOWS_JOB_GUARD_REQUIRED');
+  }
+  process.stderr.write('[mosigame lab] Checking fixed local service ports.\n');
+  assertLocalTargets(labTargets());
+  await requireVacantPorts();
+  const configPath = writeLabConfig();
+  const child = spawn(process.execPath, firebaseStartArguments(configPath), {
+    cwd: runtimeDirectory, env: createLabEnvironment(), windowsHide: true,
+    stdio: ['pipe', 'inherit', 'inherit'], detached: process.platform !== 'win32',
+  });
+  const exit = new Promise((resolve, reject) => {
+    child.once('error', reject);
+    child.once('exit', (code) => resolve(code ?? 1));
+  });
+  let stopRequested = false;
+  const stop = () => {
+    stopRequested = true;
+    if (child.exitCode !== null) return;
+    // On Windows the outer Job Object closes the complete owned tree after this
+    // launcher returns, including any Java workers orphaned by CLI termination.
+    if (process.platform === 'win32') child.kill();
+    else process.kill(-child.pid, 'SIGINT');
+  };
+  const input = createInterface({ input: process.stdin });
+  input.on('line', (line) => { if (line.trim() === 'stop') stop(); });
+  process.once('SIGINT', stop);
+  process.once('SIGTERM', stop);
+  try { const code = await exit; return stopRequested ? 0 : code; } finally {
+    input.close();
+    if (process.platform !== 'win32') {
+      try { process.kill(-child.pid, 'SIGKILL'); } catch (error) { if (error.code !== 'ESRCH') throw error; }
+    }
+  }
+}
+
+export function stopRequestFromOwner(owner) {
+  if (owner?.projectId !== PROJECT_ID || !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/.test(owner.nonce ?? '') ||
+      !Number.isInteger(owner.supervisorPid) || owner.supervisorPid <= 0 || !Number.isInteger(owner.childPid) || owner.childPid <= 0) {
+    throw new Error('LAB_STOP_OWNER_REJECTED');
+  }
+  return owner.nonce + '\n';
+}
+
+export function requestLocalStop() {
+  const owner = JSON.parse(readFileSync(path.join(runtimeDirectory, 'owner.json'), 'utf8'));
+  writeFileSync(path.join(runtimeDirectory, 'stop.request'), stopRequestFromOwner(owner));
+  return { status: 'STOP_REQUESTED', projectId: PROJECT_ID };
+}
+
+export async function main(argv) {
+  if (argv.length !== 1 || !['config', 'status', 'seed', 'start', 'stop'].includes(argv[0])) throw new Error('LAB_ARGUMENTS_REJECTED');
+  if (argv[0] === 'config') return { status: 'PASS', projectId: PROJECT_ID, configPath: writeLabConfig() };
+  if (argv[0] === 'status') return { status: 'PASS', ...await assertRunningLab() };
+  if (argv[0] === 'seed') return seedLocalLab();
+  if (argv[0] === 'stop') return requestLocalStop();
+  return { status: 'STOPPED', exitCode: await startLocalLab(), projectId: PROJECT_ID };
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  main(process.argv.slice(2)).then((result) => {
+    process.stdout.write(JSON.stringify(result) + '\n');
+    process.exitCode = result.exitCode ?? 0;
+  }).catch((error) => {
+    // Do not emit SDK errors containing account data, tokens, or payloads.
+    const reason = /^LAB_[A-Z0-9_]+$/.test(error.message ?? '') ? error.message : 'LAB_OPERATION_FAILED';
+    process.stderr.write(`${reason}: Local emulator lab operation failed.\n`);
+    process.exitCode = 1;
+  });
+}
