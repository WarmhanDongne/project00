+      assert.equal(readFileSync(config.path(config.src[name].rules), 'utf8'), readFileSync(path.join(repositoryRoot, file), 'utf8'));
+    }
+  } finally {
+    if (original === undefined) delete process.env.XDG_CONFIG_HOME;
+    else process.env.XDG_CONFIG_HOME = original;
+    rmSync(fixture, { recursive: true, force: true });
+  }
+});
+
+test('Windows Job Object stops only its owned descendants', { skip: process.platform !== 'win32' }, async () => {
+  const fixture = mkdtempSync(path.join(os.tmpdir(), 'mosigame-lab-owned-job-'));
+  const fakeScript = path.join(fixture, 'fake-backend.mjs');
+  const childPidFile = path.join(fixture, 'child.pid');
+  const guardScript = path.join(repositoryRoot, 'tool', 'emulator_lab', 'start_local_backend.ps1');
+  const quote = (x) => "'" + x.replaceAll("'", "''") + "'";
+  const unrelated = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore', windowsHide: true });
+  try {
+    writeFileSync(fakeScript, `import { spawn } from 'node:child_process';\nimport { writeFileSync } from 'node:fs';\nprocess.stdout.write('fake backend stdout\\n');\nprocess.stderr.write('fake backend stderr\\n');\nconst child = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore', windowsHide: true });\nwriteFileSync(${JSON.stringify(childPidFile)}, String(child.pid));\nchild.unref();\n`);
+    const ps = `$labText = Get-Content -LiteralPath ${quote(guardScript)} -Raw; ` +
+      `$labMatch = [regex]::Match($labText, "(?s)Add-Type -TypeDefinition @'\\r?\\n(.*?)\\r?\\n'@"); ` +
+      `if (-not $labMatch.Success) { throw 'Guard missing' }; ` +
+      `Add-Type -TypeDefinition $labMatch.Groups[1].Value; ` +
+      `$labCode = [MosigameLocalLabJob]::Run(${quote(process.execPath)}, ${quote(fakeScript)}, ${quote(fixture)}); exit $labCode`;
+    const result = spawnSync('powershell.exe', ['-NoProfile', '-Command', ps], { encoding: 'utf8', timeout: 30000, windowsHide: true });
+    assert.equal(result.status, 0, result.stderr);
+    assert.match(result.stdout, /fake backend stdout/);
+    assert.match(result.stderr, /fake backend stderr/);
+    assert.match(result.stderr, /Owned process tree empty; cleanup confirmed/);
+    const ownedPid = Number(readFileSync(childPidFile, 'utf8'));
+    assert.throws(() => process.kill(ownedPid, 0), { code: 'ESRCH' });
+    assert.equal(unrelated.exitCode, null);
+    assert.doesNotThrow(() => process.kill(unrelated.pid, 0));
+  } finally {
+    const stopped = once(unrelated, 'exit');
+    unrelated.kill();
+    await stopped;
+    rmSync(fixture, { recursive: true, force: true });
+  }
+});
diff --git a/tool/emulator_lab/rtdb_trigger_probe.mjs b/tool/emulator_lab/rtdb_trigger_probe.mjs
new file mode 100644
--- /dev/null
+++ b/tool/emulator_lab/rtdb_trigger_probe.mjs
@@ -0,0 +1,234 @@
+import { randomUUID } from 'node:crypto';
+import path from 'node:path';
+import { setTimeout as delay } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+import { assertLocalTargets, assertRunningLab, labTargets, localJson, PROJECT_ID } from './local_backend.mjs';
+
+export function createProbeFixture(runId, now) {
+  if (!/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/.test(runId) ||
+      !Number.isSafeInteger(now) || now < 0) throw new Error('LAB_PROBE_ID_REJECTED');
+  // This intentionally cannot be joined through the five-character UI code.
+  const roomCode = `LAB_PROBE_${runId}`;
+  const controllerUid = `lab-probe-controller-${runId}`;
+  const operationId = `lab-probe-operation-${runId}`;
+  const playerUid = `lab-probe-player-${runId}`;
+  const otherUid = `lab-probe-other-${runId}`;
+  return {
+    roomPath: `rooms/${roomCode}`,
+    reservationPath: `roomCreateRequests/${controllerUid}/${operationId}`,
+    playerUid,
+    room: {
+      _labProbeRunId: runId, roomCode, controllerUid, creationOperationId: operationId,
+      controllerSessionId: `lab-probe-session-${runId}`,
+      status: 'waiting', selectedGame: 'liars_poker', createdAt: now,
+      updatedAt: 0, cleanupAt: now + 900_000,
+      controllerPresence: { connected: true, lastSeen: now },
+      players: Object.fromEntries([[playerUid, 'LabProbeA', 'frog'], [otherUid, 'LabProbeB', 'bear']]
+        .map(([uid, nickname, characterId], seatIndex) => [uid, {
+          nickname, characterId, seatIndex, role: 'player', status: 'active',
+          isConnected: true, lastSeen: now,
+        }])),
+      game: {
+        public: {
+          phase: 'playing', round: 1, startedAt: now, revision: 0, updatedAt: now,
+          turnUid: playerUid, turnDeadlineAt: now + 60_000,
+          players: { [playerUid]: { status: 'alive' }, [otherUid]: { status: 'alive' } },
+        },
+        // Keep a server object after RTDB drops empty maps.
+        server: { probeMarker: runId },
+      },
+    },
+    reservation: {
+      _labProbeRunId: runId, roomCode,
+      controllerSessionId: `lab-probe-session-${runId}`, createdAt: now,
+    },
+  };
+}
+
+// This fixture probe proves Emulator trigger wiring, not any of the 62 Android
+// scenarios. It never calls a game handler directly or manufactures its output.
+export async function probeRtdbTriggers({
+  targets = labTargets(), request = localJson, readiness = assertRunningLab,
+  now = Date.now, pause = delay, runId = randomUUID(), timeoutMs = 120_000,
+  totalTimeoutMs = 600_000, pollMs = 250,
+} = {}) {
+  assertLocalTargets(targets);
+  if (!Number.isInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 120_000 ||
+      !Number.isInteger(totalTimeoutMs) || totalTimeoutMs < 1 || totalTimeoutMs > 600_000 ||
+      !Number.isInteger(pollMs) || pollMs < 1 || pollMs > 1000) throw new Error('LAB_PROBE_TIMEOUT_REJECTED');
+  const startedAt = now();
+  const fixture = createProbeFixture(runId, startedAt);
+  const totalDeadline = startedAt + totalTimeoutMs;
+  // Reserve bounded time for owned-path cleanup even after observation expires.
+  const cleanupReserveMs = Math.min(30_000, Math.floor(totalTimeoutMs / 10));
+  let activeDeadline = totalDeadline - cleanupReserveMs;
+  const boundedRequest = (url, options = {}, deadline = activeDeadline) => {
+    const remaining = Math.min(activeDeadline, deadline) - now();
+    if (remaining < 1) throw new Error('LAB_PROBE_TOTAL_TIMEOUT');
+    return request(url, {
+      ...options, timeoutMs: Math.min(options.timeoutMs ?? 10_000, 30_000, remaining),
+    });
+  };
+  await readiness(targets, boundedRequest);
+  const base = new URL(targets.databaseURL);
+  const headers = { Authorization: 'Bearer owner' }; // Emulator-only reserved identity.
+  const evidence = [];
+  const cleanup = { roomRemoved: false, reservationRemoved: false };
+  const claimAttempts = new Set();
+  let stage = 'claim';
+  let failure;
+
+  const access = (nodePath, options = {}, deadline = activeDeadline) => {
+    if (nodePath !== fixture.reservationPath && nodePath !== fixture.roomPath &&
+        !nodePath.startsWith(fixture.roomPath + '/')) throw new Error('LAB_PROBE_PATH_REJECTED');
+    const url = new URL(base);
+    url.pathname = `/${nodePath}.json`;
+    return boundedRequest(url.href, { ...options, headers: { ...headers, ...options.headers } }, deadline);
+  };
+  const readRoom = (deadline) => access(fixture.roomPath, {}, deadline);
+  const waitFor = async (read, predicate) => {
+    const deadline = Math.min(now() + timeoutMs, activeDeadline);
+    while (now() < deadline) {
+      let value;
+      try { value = await read(deadline); } catch (error) {
+        if (now() < deadline) throw error;
+        break;
+      }
+      if (now() >= deadline) break;
+      if (predicate(value)) return value;
+      await pause(Math.min(pollMs, deadline - now()));
+    }
+    throw new Error(now() >= activeDeadline ? 'LAB_PROBE_TOTAL_TIMEOUT' : 'LAB_PROBE_OBSERVATION_TIMEOUT');
+  };
+  const put = (nodePath, body) => access(nodePath, { method: 'PUT', body });
+  const deleteOwned = async (nodePath) => {
+    const value = await access(nodePath);
+    if (value !== null) {
+      if (value?._labProbeRunId !== runId) throw new Error('LAB_PROBE_OWNERSHIP_REJECTED');
+      await access(nodePath, { method: 'DELETE' });
+    }
+    await waitFor((deadline) => access(nodePath, {}, deadline), (value) => value === null);
+  };
+
+  try {
+    if (await readRoom() !== null || await access(fixture.reservationPath) !== null) {
+      throw new Error('LAB_PROBE_COLLISION');
+    }
+    // RTDB's null_etag condition prevents overwriting a concurrent claimant.
+    claimAttempts.add(fixture.reservationPath);
+    await access(fixture.reservationPath, {
+      method: 'PUT', body: fixture.reservation, headers: { 'If-Match': 'null_etag' },
+    });
+    claimAttempts.add(fixture.roomPath);
+    await access(fixture.roomPath, {
+      method: 'PUT', body: fixture.room, headers: { 'If-Match': 'null_etag' },
+    });
+
+    stage = 'room-status-mirror';
+    await put(fixture.roomPath + '/game/public/status', 'playing');
+    const playing = await waitFor(readRoom, (room) => room?.status === 'playing' &&
+      Number.isFinite(room.updatedAt) && room.updatedAt > 0 && room.cleanupAt == null);
+
+    stage = 'player-connection';
+    // Cold workers may take longer than the fixture's initial turn timer.
+    await put(fixture.roomPath + '/game/public/turnDeadlineAt', now() + 60_000);
+    const beforePlayer = playing.game.public.revision;
+    await put(`${fixture.roomPath}/players/${fixture.playerUid}/isConnected`, false);
+    const disconnected = await waitFor(readRoom, (room) => {
+      const interruption = room?.game?.public?.interruption;
+      const saved = room?.game?.server?.interruption;
+      return interruption?.playerUid === fixture.playerUid && interruption.reason === 'disconnected' &&
+        saved?.id === interruption.id && Number.isFinite(saved.previousTurnRemainingMs) &&
+        saved.previousTurnRemainingMs > 0 && room.game.public.turnDeadlineAt == null &&
+        room.game.public.revision > beforePlayer;
+    });
+    const playerPausedRevision = disconnected.game.public.revision;
+    await put(`${fixture.roomPath}/players/${fixture.playerUid}/isConnected`, true);
+    const playerResumed = await waitFor(readRoom, (room) => room?.game?.public?.interruption == null &&
+      room?.game?.server?.interruption == null && Number.isFinite(room?.game?.public?.turnDeadlineAt) &&
+      room.game.public.turnDeadlineAt > now() && room.game.public.revision > playerPausedRevision);
+    evidence.push({
+      trigger: 'game_common_interruption_on_connection_changed',
+      pauseRevision: playerPausedRevision, resumeRevision: playerResumed.game.public.revision,
+      remainingTimeSaved: true, pauseAndResumeObserved: true,
+    });
+
+    stage = 'controller-connection';
+    // Fresh probe timer is explicit fixture input, never counted as trigger output.
+    await put(fixture.roomPath + '/game/public/turnDeadlineAt', now() + 60_000);
+    const beforeController = playerResumed.game.public.revision;
+    await put(fixture.roomPath + '/controllerPresence/connected', false);
+    const controllerPaused = await waitFor(readRoom, (room) => {
+      const saved = room?.game?.server?.controllerPause;
+      return Number.isFinite(saved?.startedAt) && Number.isFinite(saved?.previousTurnRemainingMs) &&
+        saved.previousTurnRemainingMs > 0 && room.game.public.turnDeadlineAt == null &&
+        room.game.public.revision > beforeController;
+    });
+    const controllerPausedRevision = controllerPaused.game.public.revision;
+    await put(fixture.roomPath + '/controllerPresence/connected', true);
+    const controllerResumed = await waitFor(readRoom, (room) => room?.game?.server?.controllerPause == null &&
+      Number.isFinite(room?.game?.public?.turnDeadlineAt) && room.game.public.turnDeadlineAt > now() &&
+      room.game.public.revision > controllerPausedRevision);
+    evidence.push({
+      trigger: 'game_common_controller_presence_changed',
+      pauseRevision: controllerPausedRevision, resumeRevision: controllerResumed.game.public.revision,
+      remainingTimeSaved: true, pauseAndResumeObserved: true,
+    });
+
+    stage = 'room-status-mirror';
+    await put(fixture.roomPath + '/game/public/status', 'finished');
+    const finished = await waitFor(readRoom, (room) => room?.status === 'finished' &&
+      Number.isFinite(room.finishedAt) && Number.isFinite(room.retainUntil) &&
+      room.retainUntil - room.finishedAt === 900_000 && room.cleanupAt === room.retainUntil);
+    evidence.push({
+      trigger: 'syncRealtimeRoomGameStatus', playingMirrored: playing.status === 'playing',
+      finishedMirrored: finished.status === 'finished', retentionMs: 900_000,
+    });
+
+    stage = 'deleted-room-reservation';
+    const reservationBefore = await access(fixture.reservationPath);
+    if (reservationBefore?._labProbeRunId !== runId) throw new Error('LAB_PROBE_RESERVATION_MISSING');
+    // Do not delete the reservation ourselves before observing the backstop.
+    await access(fixture.roomPath, { method: 'DELETE' });
+    await waitFor((deadline) => access(fixture.reservationPath, {}, deadline), (value) => value === null);
+    evidence.push({ trigger: 'cleanupDeletedRoomCreationRequest', reservationExistedBefore: true,
+      reservationRemovedByTrigger: true });
+  } catch (error) {
+    failure = { stage, reason: /^LAB_[A-Z0-9_]+$/.test(error.message ?? '') ? error.message : 'LAB_PROBE_FAILED' };
+  } finally {
+    activeDeadline = totalDeadline;
+    for (const [nodePath, key] of [[fixture.roomPath, 'roomRemoved'], [fixture.reservationPath, 'reservationRemoved']]) {
+      try {
+        if (!claimAttempts.has(nodePath)) {
+          cleanup[key] = await access(nodePath) === null;
+          continue;
+        }
+        await deleteOwned(nodePath); cleanup[key] = true;
+      } catch (error) {
+        failure ??= { stage: 'cleanup', reason: /^LAB_[A-Z0-9_]+$/.test(error.message ?? '') ? error.message : 'LAB_PROBE_CLEANUP_FAILED' };
+      }
+    }
+  }
+  return {
+    status: !failure && evidence.length === 4 && cleanup.roomRemoved && cleanup.reservationRemoved ? 'PASS' : 'FAIL',
+    kind: 'RTDB_FIXTURE_PROBE', projectId: PROJECT_ID, runId,
+    limits: { observationTimeoutMs: timeoutMs, totalTimeoutMs, cleanupReserveMs },
+    elapsedMs: Math.max(0, now() - startedAt),
+    productScenariosExecuted: 0, roomPath: fixture.roomPath, reservationPath: fixture.reservationPath,
+    evidence, cleanup, ...(failure ? { failure } : {}),
+  };
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  if (process.argv.length !== 2) {
+    process.stderr.write('LAB_PROBE_ARGUMENTS_REJECTED\n'); process.exitCode = 1;
+  } else {
+    probeRtdbTriggers().then((result) => {
+      process.stdout.write(JSON.stringify(result) + '\n');
+      process.exitCode = result.status === 'PASS' ? 0 : 1;
+    }).catch((error) => {
+      const reason = /^LAB_[A-Z0-9_]+$/.test(error.message ?? '') ? error.message : 'LAB_PROBE_SETUP_FAILED';
+      process.stderr.write(reason + '\n'); process.exitCode = 1;
+    });
+  }
+}
diff --git a/tool/emulator_lab/rtdb_trigger_probe.test.mjs b/tool/emulator_lab/rtdb_trigger_probe.test.mjs
new file mode 100644
--- /dev/null
+++ b/tool/emulator_lab/rtdb_trigger_probe.test.mjs
@@ -0,0 +1,216 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createProbeFixture, probeRtdbTriggers } from './rtdb_trigger_probe.mjs';
+import { labTargets } from './local_backend.mjs';
+
+const runId = '01234567-89ab-4cde-8123-456789abcdef';
+
+// Simulated external handlers let runner tests withhold each independent output.
+// They never contact a running Emulator or any user's room.
+function backend({ missing, collision, collisionReservation, failAfterRoomWrite, hijackRoom, coldStatusMs = 0 } = {}) {
+  let clock = 1_000_000;
+  const fixture = createProbeFixture(runId, clock);
+  let room = collision ? { _labProbeRunId: 'someone-else', sentinel: true } : null;
+  let reservation = collisionReservation ? structuredClone(fixture.reservation) : null;
+  let pendingStatus;
+  const calls = [];
+  const mirrorStatus = (status) => {
+    room.status = status; room.updatedAt = clock; delete room.cleanupAt;
+    if (status === 'finished') {
+      room.finishedAt = clock; room.retainUntil = clock + 900_000; room.cleanupAt = room.retainUntil;
+    }
+  };
+  const request = async (rawUrl, options = {}) => {
+    const url = new URL(rawUrl);
+    const nodePath = url.pathname.slice(1, -5);
+    assert.equal(url.origin, 'http://127.0.0.1:9000');
+    assert.equal(url.searchParams.get('ns'), 'demo-mosigame-lab-default-rtdb');
+    assert.equal(options.headers.Authorization, 'Bearer owner');
+    assert.ok(nodePath === fixture.reservationPath || nodePath === fixture.roomPath ||
+      nodePath.startsWith(fixture.roomPath + '/'));
+    const method = options.method ?? 'GET';
+    calls.push({ nodePath, method, body: options.body, headers: options.headers, timeoutMs: options.timeoutMs });
+    assert.ok(options.timeoutMs > 0 && options.timeoutMs <= 30_000);
+    if (nodePath === fixture.reservationPath) {
+      if (method === 'PUT') { assert.equal(options.headers['If-Match'], 'null_etag'); reservation = structuredClone(options.body); }
+      if (method === 'DELETE') reservation = null;
+      return structuredClone(reservation);
+    }
+    if (nodePath === fixture.roomPath) {
+      if (room && pendingStatus && clock >= pendingStatus.at) {
+        mirrorStatus(pendingStatus.status); pendingStatus = undefined;
+      }
+      if (method === 'PUT') {
+        assert.equal(options.headers['If-Match'], 'null_etag');
+        room = structuredClone(options.body);
+        if (hijackRoom) room._labProbeRunId = 'someone-else';
+        if (failAfterRoomWrite) throw new Error('Synthetic response loss');
+      }
+      if (method === 'DELETE') { room = null; if (missing !== 'deletion') reservation = null; }
+      return structuredClone(room);
+    }
+    assert.equal(method, 'PUT');
+    if (nodePath.endsWith('/game/public/status')) {
+      room.game.public.status = options.body;
+      if (missing !== 'status') {
+        if (options.body === 'playing' && coldStatusMs) pendingStatus = { status: options.body, at: clock + coldStatusMs };
+        else mirrorStatus(options.body);
+      }
+    } else if (nodePath.endsWith('/game/public/turnDeadlineAt')) {
+      room.game.public.turnDeadlineAt = options.body;
+    } else if (nodePath.endsWith('/isConnected')) {
+      room.players[fixture.playerUid].isConnected = options.body;
+      if (missing !== 'player') {
+        if (!options.body) {
+          room.game.public.interruption = { id: 'external-player-interruption', playerUid: fixture.playerUid, reason: 'disconnected' };
+          room.game.server.interruption = {
+            id: 'external-player-interruption', previousTurnRemainingMs: Math.max(0, room.game.public.turnDeadlineAt - clock),
+          };
+          delete room.game.public.turnDeadlineAt;
+        } else {
+          delete room.game.public.interruption; delete room.game.server.interruption;
+          room.game.public.turnDeadlineAt = clock + 59_000;
+        }
+        room.game.public.revision++;
+      }
+    } else if (nodePath.endsWith('/controllerPresence/connected')) {
+      room.controllerPresence.connected = options.body;
+      if (missing !== 'controller') {
+        if (!options.body) {
+          room.game.server.controllerPause = {
+            startedAt: clock, previousTurnRemainingMs: Math.max(0, room.game.public.turnDeadlineAt - clock),
+          };
+          delete room.game.public.turnDeadlineAt;
+        } else {
+          delete room.game.server.controllerPause; room.game.public.turnDeadlineAt = clock + 59_000;
+        }
+        room.game.public.revision++;
+      }
+    } else assert.fail('Unexpected stimulus');
+    return options.body;
+  };
+  return {
+    request, readiness: async () => undefined, now: () => clock,
+    pause: async (milliseconds) => { clock += milliseconds; }, runId, timeoutMs: 20, pollMs: 5,
+    calls, contents: () => ({ room, reservation }), fixture,
+  };
+}
+
+test('fixture is isolated from UI room codes and uses handler-required fields', () => {
+  const fixture = createProbeFixture(runId, 1000);
+  assert.match(fixture.roomPath, /^rooms\/LAB_PROBE_/);
+  assert.notEqual(fixture.room.roomCode.length, 5);
+  assert.match(fixture.reservationPath, /^roomCreateRequests\/lab-probe-controller-/);
+  assert.equal(fixture.room.players[fixture.playerUid].status, 'active');
+  assert.equal(fixture.room.game.public.players[fixture.playerUid].status, 'alive');
+  assert.equal(fixture.room.game.public.status, undefined);
+  assert.throws(() => createProbeFixture('../another-room', 1000), /ID_REJECTED/);
+});
+
+test('four observed external deltas pass with exact-path cleanup and zero product scenarios', async () => {
+  const fake = backend();
+  const result = await probeRtdbTriggers(fake);
+  assert.equal(result.status, 'PASS');
+  assert.equal(result.productScenariosExecuted, 0);
+  assert.deepEqual(result.evidence.map((x) => x.trigger).sort(), [
+    'cleanupDeletedRoomCreationRequest', 'game_common_controller_presence_changed',
+    'game_common_interruption_on_connection_changed', 'syncRealtimeRoomGameStatus',
+  ]);
+  assert.deepEqual(result.cleanup, { roomRemoved: true, reservationRemoved: true });
+  assert.deepEqual(fake.contents(), { room: null, reservation: null });
+  // The runner never writes the fields it later counts as handler evidence.
+  const writes = fake.calls.filter((x) => x.method === 'PUT' && x.nodePath !== fake.fixture.roomPath &&
+    x.nodePath !== fake.fixture.reservationPath);
+  assert.ok(writes.every((x) => /\/(status|turnDeadlineAt|isConnected|connected)$/.test(x.nodePath)));
+  assert.equal(fake.calls.filter((x) => x.method === 'DELETE' && x.nodePath === fake.fixture.reservationPath).length, 0);
+});
+
+test('default 120-second observation permits cold startup and refreshes expired input timers', async () => {
+  const fake = backend({ coldStatusMs: 70_000 });
+  const result = await probeRtdbTriggers({ ...fake, timeoutMs: undefined, pollMs: 1000 });
+  assert.equal(result.status, 'PASS');
+  assert.equal(result.elapsedMs, 70_000);
+  assert.deepEqual(result.limits, { observationTimeoutMs: 120_000, totalTimeoutMs: 600_000, cleanupReserveMs: 30_000 });
+  const firstDisconnect = fake.calls.findIndex((call) => call.nodePath.endsWith('/isConnected') && call.body === false);
+  const refreshed = fake.calls.slice(0, firstDisconnect).find((call) => call.nodePath.endsWith('/turnDeadlineAt'));
+  assert.equal(refreshed.body, fake.fixture.room.createdAt + 130_000);
+  assert.equal(result.productScenariosExecuted, 0);
+});
+
+test('overall deadline bounds accumulated waiting and reserves time to clean owned paths', async () => {
+  const fake = backend({ missing: 'status' });
+  const result = await probeRtdbTriggers({ ...fake, timeoutMs: 100, totalTimeoutMs: 30 });
+  assert.equal(result.status, 'FAIL');
+  assert.equal(result.failure.reason, 'LAB_PROBE_TOTAL_TIMEOUT');
+  assert.equal(result.elapsedMs, 27);
+  assert.deepEqual(result.cleanup, { roomRemoved: true, reservationRemoved: true });
+  assert.deepEqual(fake.contents(), { room: null, reservation: null });
+  assert.ok(fake.calls.filter((call) => call.method === 'DELETE').every((call) => call.timeoutMs <= 3));
+});
+
+test('observation and overall limits reject unbounded configurations before any request', async () => {
+  let requests = 0;
+  const request = async () => { requests++; };
+  await assert.rejects(probeRtdbTriggers({ request, timeoutMs: 120_001 }), /TIMEOUT_REJECTED/);
+  await assert.rejects(probeRtdbTriggers({ request, totalTimeoutMs: 600_001 }), /TIMEOUT_REJECTED/);
+  await assert.rejects(probeRtdbTriggers({ request, totalTimeoutMs: 0 }), /TIMEOUT_REJECTED/);
+  assert.equal(requests, 0);
+});
+
+for (const missing of ['status', 'player', 'controller', 'deletion']) {
+  test(`missing ${missing} trigger output cannot pass and all owned fixtures are removed`, async () => {
+    const fake = backend({ missing });
+    const result = await probeRtdbTriggers(fake);
+    assert.equal(result.status, 'FAIL');
+    assert.equal(result.failure.reason, 'LAB_PROBE_OBSERVATION_TIMEOUT');
+    assert.ok(result.evidence.length < 4);
+    assert.deepEqual(fake.contents(), { room: null, reservation: null });
+    assert.deepEqual(result.cleanup, { roomRemoved: true, reservationRemoved: true });
+  });
+}
+
+test('unsafe targets and missing readiness cannot access any database path', async () => {
+  let calls = 0;
+  const request = async () => { calls++; throw new Error('Unexpected network request'); };
+  const unsafe = labTargets(); unsafe.projectId = 'project0000-ec01e';
+  await assert.rejects(probeRtdbTriggers({ targets: unsafe, request }), /REJECTED/);
+  await assert.rejects(probeRtdbTriggers({ request, readiness: async () => { throw new Error('Unavailable'); } }), /Unavailable/);
+  assert.equal(calls, 0);
+});
+
+test('collision preserves the existing room without writing or deleting it', async () => {
+  const fake = backend({ collision: true });
+  const result = await probeRtdbTriggers(fake);
+  assert.equal(result.status, 'FAIL');
+  assert.equal(result.failure.reason, 'LAB_PROBE_COLLISION');
