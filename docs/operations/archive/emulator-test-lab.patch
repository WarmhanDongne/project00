--- /dev/null
+++ b/tool/emulator_lab/start_local_backend.ps1
@@ -0,0 +1,209 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+if ($args.Count -ne 0) { throw 'This launcher accepts no arguments.' }
+if ([Environment]::OSVersion.Platform -ne [PlatformID]::Win32NT) {
+    throw 'On POSIX use node tool/emulator_lab/local_backend.mjs start.'
+}
+$labNodeCommand = Get-Command node.exe -CommandType Application -ErrorAction Stop |
+    Select-Object -First 1
+$labNodePath = [IO.Path]::GetFullPath($labNodeCommand.Source)
+$labScriptPath = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot 'local_backend.mjs'))
+if ($labNodePath.Contains('"') -or $labScriptPath.Contains('"')) { throw 'Invalid launcher path.' }
+$env:MOSIGAME_LAB_JOB_OWNED = '1'
+
+# Start suspended so descendants cannot escape before job admission. Closing this
+# job kills its complete tree, including emulator Java and Functions workers.
+Add-Type -TypeDefinition @'
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Microsoft.Win32.SafeHandles;
+
+public static class MosigameLocalLabJob {
+    [StructLayout(LayoutKind.Sequential)] struct SecurityAttributes {
+        public int length; public IntPtr descriptor; public bool inherit;
+    }
+    [StructLayout(LayoutKind.Sequential)] struct StartupInfo {
+        public int cb; public string reserved, desktop, title;
+        public int x, y, xSize, ySize, xChars, yChars, fill, flags;
+        public short show, reserved2; public IntPtr reservedPtr, input, output, error;
+    }
+    [StructLayout(LayoutKind.Sequential)] struct ProcessInfo {
+        public IntPtr process, thread; public uint pid, tid;
+    }
+    [StructLayout(LayoutKind.Sequential)] struct BasicLimits {
+        public long processTime, jobTime; public uint flags;
+        public UIntPtr minWorking, maxWorking; public uint activeLimit;
+        public UIntPtr affinity; public uint priority, scheduling;
+    }
+    [StructLayout(LayoutKind.Sequential)] struct IoCounters {
+        public ulong readOps, writeOps, otherOps, readBytes, writeBytes, otherBytes;
+    }
+    [StructLayout(LayoutKind.Sequential)] struct ExtendedLimits {
+        public BasicLimits basic; public IoCounters io;
+        public UIntPtr processMemory, jobMemory, peakProcess, peakJob;
+    }
+    [StructLayout(LayoutKind.Sequential)] struct Accounting {
+        public long user, kernel, periodUser, periodKernel;
+        public uint faults, processes, active, terminated;
+    }
+    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
+    static extern IntPtr CreateJobObject(IntPtr attrs, string name);
+    [DllImport("kernel32.dll", SetLastError=true)]
+    static extern bool SetInformationJobObject(IntPtr job, int type, IntPtr info, uint size);
+    [DllImport("kernel32.dll", SetLastError=true)]
+    static extern bool QueryInformationJobObject(IntPtr job, int type, out Accounting info, uint size, IntPtr returned);
+    [DllImport("kernel32.dll", SetLastError=true)]
+    static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
+    [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)]
+    static extern bool CreateProcess(string app, StringBuilder cmd, IntPtr pa, IntPtr ta,
+        bool inherit, uint flags, IntPtr env, string cwd, ref StartupInfo si, out ProcessInfo pi);
+    [DllImport("kernel32.dll", SetLastError=true)] static extern uint ResumeThread(IntPtr thread);
+    [DllImport("kernel32.dll", SetLastError=true)] static extern bool TerminateProcess(IntPtr process, uint code);
+    [DllImport("kernel32.dll", SetLastError=true)] static extern bool TerminateJobObject(IntPtr job, uint code);
+    [DllImport("kernel32.dll", SetLastError=true)] static extern bool GetExitCodeProcess(IntPtr process, out uint code);
+    [DllImport("kernel32.dll", SetLastError=true)] static extern bool CloseHandle(IntPtr handle);
+    [DllImport("kernel32.dll", SetLastError=true)] static extern bool CreatePipe(out IntPtr read, out IntPtr write, ref SecurityAttributes attrs, uint size);
+    [DllImport("kernel32.dll", SetLastError=true)] static extern bool SetHandleInformation(IntPtr handle, uint mask, uint flags);
+
+    sealed class ForwardState { public int outputObserved, stopRequested; }
+    static void Close(ref IntPtr handle) {
+        if (handle != IntPtr.Zero) { CloseHandle(handle); handle = IntPtr.Zero; }
+    }
+    static FileStream OwnStream(ref IntPtr handle, FileAccess access) {
+        SafeFileHandle safe = new SafeFileHandle(handle, true); handle = IntPtr.Zero;
+        return new FileStream(safe, access, 4096, false);
+    }
+    static void Forward(FileStream source, Stream target, ForwardState state) {
+        try {
+            byte[] buffer = new byte[4096]; int length;
+            while ((length = source.Read(buffer, 0, buffer.Length)) > 0) {
+                Interlocked.Exchange(ref state.outputObserved, 1);
+                target.Write(buffer, 0, length); target.Flush();
+            }
+        } catch (IOException) { } finally { source.Dispose(); }
+    }
+
+    static bool Empty(IntPtr job) {
+        Accounting info;
+        if (!QueryInformationJobObject(job, 1, out info, (uint)Marshal.SizeOf(typeof(Accounting)), IntPtr.Zero))
+            throw new InvalidOperationException("Lab job accounting failed.");
+        return info.active == 0;
+    }
+    public static int Run(string executable, string script, string cwd) {
+        return Run(executable, script, cwd, null);
+    }
+    public static int Run(string executable, string script, string cwd, string controlDirectory) {
+        IntPtr job = IntPtr.Zero, limitsPtr = IntPtr.Zero;
+        IntPtr inputRead = IntPtr.Zero, inputWrite = IntPtr.Zero;
+        IntPtr outputRead = IntPtr.Zero, outputWrite = IntPtr.Zero;
+        IntPtr errorRead = IntPtr.Zero, errorWrite = IntPtr.Zero;
+        ProcessInfo pi = new ProcessInfo(); bool admitted = false;
+        FileStream ownerLock = null; StreamWriter input = null;
+        Task outputTask = null, errorTask = null;
+        ForwardState state = new ForwardState();
+        string nonce = Guid.NewGuid().ToString("D");
+        string ownerPath = null, stopPath = null;
+        try {
+            if (controlDirectory != null) {
+                Directory.CreateDirectory(controlDirectory);
+                ownerLock = new FileStream(Path.Combine(controlDirectory, "owner.lock"), FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+                ownerPath = Path.Combine(controlDirectory, "owner.json");
+                stopPath = Path.Combine(controlDirectory, "stop.request");
+            }
+            job = CreateJobObject(IntPtr.Zero, null);
+            if (job == IntPtr.Zero) throw new InvalidOperationException("Lab job creation failed.");
+            ExtendedLimits limits = new ExtendedLimits(); limits.basic.flags = 0x2000;
+            limitsPtr = Marshal.AllocHGlobal(Marshal.SizeOf(typeof(ExtendedLimits)));
+            Marshal.StructureToPtr(limits, limitsPtr, false);
+            if (!SetInformationJobObject(job, 9, limitsPtr, (uint)Marshal.SizeOf(typeof(ExtendedLimits))))
+                throw new InvalidOperationException("Lab kill-on-close configuration failed.");
+            SecurityAttributes attrs = new SecurityAttributes();
+            attrs.length = Marshal.SizeOf(typeof(SecurityAttributes)); attrs.inherit = true;
+            if (!CreatePipe(out inputRead, out inputWrite, ref attrs, 0) || !SetHandleInformation(inputWrite, 1, 0) ||
+                !CreatePipe(out outputRead, out outputWrite, ref attrs, 0) || !SetHandleInformation(outputRead, 1, 0) ||
+                !CreatePipe(out errorRead, out errorWrite, ref attrs, 0) || !SetHandleInformation(errorRead, 1, 0))
+                throw new InvalidOperationException("Lab owned stdio pipe creation failed.");
+            StartupInfo si = new StartupInfo(); si.cb = Marshal.SizeOf(typeof(StartupInfo));
+            si.flags = 0x100; si.input = inputRead; si.output = outputWrite; si.error = errorWrite;
+            StringBuilder cmd = new StringBuilder("\"" + executable + "\" \"" + script + "\" start");
+            if (!CreateProcess(executable, cmd, IntPtr.Zero, IntPtr.Zero, true, 0x08000004,
+                IntPtr.Zero, cwd, ref si, out pi)) throw new InvalidOperationException("Lab suspended process creation failed (Win32 " + Marshal.GetLastWin32Error() + ").");
+            Close(ref inputRead); Close(ref outputWrite); Close(ref errorWrite);
+            if (!AssignProcessToJobObject(job, pi.process)) throw new InvalidOperationException("Lab job admission failed.");
+            admitted = true;
+            FileStream output = OwnStream(ref outputRead, FileAccess.Read);
+            FileStream error = OwnStream(ref errorRead, FileAccess.Read);
+            input = new StreamWriter(OwnStream(ref inputWrite, FileAccess.Write), new UTF8Encoding(false)); input.AutoFlush = true;
+            outputTask = Task.Run(delegate { Forward(output, Console.OpenStandardOutput(), state); });
+            errorTask = Task.Run(delegate { Forward(error, Console.OpenStandardError(), state); });
+            StreamWriter childInput = input;
+            Task.Run(delegate {
+                try {
+                    string line;
+                    while ((line = Console.ReadLine()) != null) {
+                        lock (childInput) { childInput.WriteLine(line); }
+                        if (line.Trim() == "stop") Interlocked.Exchange(ref state.stopRequested, 1);
+                    }
+                    // Keep the child pipe open when a tool closes its input.
+                    // An exact-owner stop.request remains available in that case.
+                } catch (IOException) { }
+            });
+            if (ownerPath != null) {
+                File.WriteAllText(ownerPath, "{\"projectId\":\"demo-mosigame-lab\",\"nonce\":\"" + nonce +
+                    "\",\"supervisorPid\":" + Process.GetCurrentProcess().Id + ",\"childPid\":" + pi.pid + "}");
+            }
+            if (ResumeThread(pi.thread) == UInt32.MaxValue) throw new InvalidOperationException("Lab launcher resume failed.");
+            Console.Error.WriteLine("[mosigame lab] Owned backend started. Send a line containing stop to finish.");
+            Stopwatch deadline = Stopwatch.StartNew(); uint exit = 259;
+            Stopwatch stopping = null;
+            while (deadline.Elapsed.TotalHours < 4) {
+                if (!GetExitCodeProcess(pi.process, out exit)) throw new InvalidOperationException("Lab launcher status failed.");
+                if (exit != 259) break;
+                if (stopPath != null && File.Exists(stopPath)) {
+                    string requestedNonce = File.ReadAllText(stopPath).Trim();
+                    if (requestedNonce == nonce) {
+                        lock (childInput) { childInput.WriteLine("stop"); }
+                        Interlocked.Exchange(ref state.stopRequested, 1);
+                        File.Delete(stopPath);
+                    }
+                }
+                if (Interlocked.CompareExchange(ref state.stopRequested, 0, 0) != 0) {
+                    if (stopping == null) stopping = Stopwatch.StartNew();
+                    if (stopping.ElapsedMilliseconds >= 5000) { exit = 0; break; }
+                }
+                if (Interlocked.CompareExchange(ref state.outputObserved, 0, 0) == 0 && deadline.ElapsedMilliseconds >= 60000) {
+                    Console.Error.WriteLine("[mosigame lab] Child startup output absent after 60 seconds.");
+                    exit = 3; break;
+                }
+                Thread.Sleep(200);
+            }
+            if (exit == 259) exit = 1;
+            if (!Empty(job) && !TerminateJobObject(job, exit)) throw new InvalidOperationException("Lab job termination failed.");
+            Stopwatch cleanup = Stopwatch.StartNew();
+            while (!Empty(job) && cleanup.ElapsedMilliseconds < 5000) Thread.Sleep(50);
+            if (!Empty(job)) throw new InvalidOperationException("Lab job cleanup unconfirmed.");
+            if (outputTask != null && errorTask != null) Task.WaitAll(new Task[] { outputTask, errorTask }, 3000);
+            Console.Error.WriteLine("[mosigame lab] Owned process tree empty; cleanup confirmed.");
+            return (int)exit;
+        } finally {
+            if (pi.process != IntPtr.Zero && !admitted) TerminateProcess(pi.process, 4);
+            if (job != IntPtr.Zero) CloseHandle(job);
+            if (input != null) input.Dispose();
+            Close(ref inputRead); Close(ref inputWrite); Close(ref outputRead); Close(ref outputWrite); Close(ref errorRead); Close(ref errorWrite);
+            if (pi.thread != IntPtr.Zero) CloseHandle(pi.thread);
+            if (pi.process != IntPtr.Zero) CloseHandle(pi.process);
+            if (limitsPtr != IntPtr.Zero) Marshal.FreeHGlobal(limitsPtr);
+            if (ownerPath != null && ownerLock != null && File.Exists(ownerPath)) File.Delete(ownerPath);
+            if (ownerLock != null) ownerLock.Dispose();
+        }
+    }
+}
+'@
+$labControlDirectory = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\..\.firebase\emulator-lab'))
+$labExitCode = [MosigameLocalLabJob]::Run($labNodePath, $labScriptPath, $PSScriptRoot, $labControlDirectory)
+exit $labExitCode
