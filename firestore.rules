rules_version = '2';

// 방과 게임 상태는 Realtime Database(`database.rules.json`)에만 있습니다.
// Firestore에는 게임 스토어 목록과 사용자 프로필만 남습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 게임 스토어 목록입니다. 등록과 수정은 콘솔에서만 합니다.
    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 사용자 프로필과 보유 게임(`ownedGames`)입니다.
    // 쓰기는 Cloud Functions(`syncGoogleUserProfile`)만 수행합니다.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
