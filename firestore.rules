rules_version = '2';

// 방과 게임 상태는 Realtime Database(`database.rules.json`)에만 있습니다.
// Firestore에는 게임 스토어 목록, 사용자 프로필, 온보딩 상태만 남습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 게임 스토어 목록입니다. 등록과 수정은 콘솔에서만 합니다.
    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 사용자 프로필과 보유 게임(`ownedGames`)입니다. 민감 필드가 같은 문서에
    // 있으므로 본인만 읽습니다. 그룹 보유 게임은 인증된 callable이 방 참가자를
    // 검증한 뒤 필요한 ID만 반환합니다.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // 인증·프로필 설정 단계는 본인만 읽고 Cloud Functions만 씁니다.
    match /userOnboarding/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
  }
}
