{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "project0000-ec01e",
          "appId": "1:93097008048:android:0ccdec23053fc259d49475",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "project0000-ec01e",
          "appId": "1:93097008048:ios:7cc378f1a02877ffd49475",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase/firebase_options.dart": {
          "projectId": "project0000-ec01e",
          "configurations": {
            "android": "1:93097008048:android:0ccdec23053fc259d49475",
            "ios": "1:93097008048:ios:7cc378f1a02877ffd49475",
            "web": "1:93097008048:web:0f1a8474555be068d49475"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "\"$RESOURCE_DIR/node_modules/.bin/eslint\" --ext .js,.ts \"$RESOURCE_DIR/src\"",
        "\"$RESOURCE_DIR/node_modules/.bin/tsc\" --project \"$RESOURCE_DIR/tsconfig.json\""
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "project0000-ec01e",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
