{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "catalog:rules:dry-run": "node scripts/update-game-rules.mjs --dry-run",
    "catalog:rules:update": "node scripts/update-game-rules.mjs",
    "catalog:preview:dry-run": "node scripts/update-game-preview.mjs --dry-run",
    "catalog:preview:update": "node scripts/update-game-preview.mjs",
    "catalog:names:dry-run": "node scripts/update-game-localized-names.mjs",
    "catalog:names:update": "node scripts/update-game-localized-names.mjs --apply",
    "catalog:localizations:dry-run": "node scripts/update-game-localized-names.mjs",
    "catalog:localizations:update": "node scripts/update-game-localized-names.mjs --apply",
    "catalog:rebuild:dry-run": "node scripts/rebuild-game-catalog.mjs",
    "catalog:rebuild": "node scripts/rebuild-game-catalog.mjs --apply --confirm-project=project0000-ec01e",
    "catalog:holdem:dry-run": "node scripts/register-holdem.mjs --dry-run",
    "catalog:holdem:register": "node scripts/register-holdem.mjs",
    "catalog:yut:dry-run": "node scripts/seed-yut-catalog.mjs",
    "catalog:yut:seed": "node scripts/seed-yut-catalog.mjs --apply --confirm-project=project0000-ec01e",
    "assets:holdem:dry-run": "node scripts/upload-holdem-assets.mjs --dry-run",
    "assets:holdem:upload": "node scripts/upload-holdem-assets.mjs",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "2.1.7"
  },
  "private": true
}
